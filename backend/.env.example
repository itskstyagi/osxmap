# The UI defaults to http://127.0.0.1:8787 and can be configured with
# ?api=https://your-api-host or window.MONUMENT_API_URL.
HOST=127.0.0.1
PORT=8787

# Comma-separated browser origins, or * for public browser access.
ALLOWED_ORIGINS=*
APP_USER_AGENT=MonoCityExplorer/1.0 (replace-with-your-email@example.com)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional OpenBuildingMap local mirror. It becomes the primary source for
# building footprints; OpenStreetMap and Overture remain fallbacks.
OPENBUILDINGMAP_API_URL=
OPENBUILDINGMAP_TILE_TTL_DAYS=7

# Leave OVERTURE_BUILDINGS_PATH empty for the bounded remote fallback.
OVERTURE_BUILDINGS_PATH=
OVERTURE_RELEASE=2026-06-17.0
DISABLE_OVERTURE=0

# These defaults retain the source project's local data locations.
DATABASE_PATH=./backend/data/monument.db
DUCKDB_PATH=./__duckdb/duckdb.exe
