# Monument is a single-machine, local-only service. The API must remain bound
# to a loopback host and is not an authenticated remote deployment.
HOST=127.0.0.1
PORT=8787
# Bound local requests so provider calls and DuckDB work cannot consume every
# server thread. Increase only after profiling the local machine.
MAX_CONCURRENT_REQUESTS=8

# OpenAI-compatible map agent. Use the API root, not the /chat/completions
# suffix; the backend keeps this key and every model request server-side.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_NAME=
# Optional generation controls. Leave blank unless the configured compatible
# gateway supports them. Azure reasoning deployments use max_completion_tokens.
AGENT_MAX_TOKENS=
AGENT_TEMPERATURE=

# Comma-separated local browser origins. The default accommodates local static
# servers during development.
ALLOWED_ORIGINS=*
APP_USER_AGENT=MonoCityExplorer/1.0 (replace-with-your-email@example.com)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Pause all Overpass requests after a 429 response (the server also honors Retry-After).
OVERPASS_BACKOFF_SECONDS=120

# The local Dijkstra search uses an Overpass OSM road graph first. This hosted
# OSRM router is used only when that graph is unavailable or disconnected.
# Set a managed or self-hosted OSRM-compatible endpoint before production use.
OSM_ROUTER_BASE_URL=https://router.project-osrm.org
OSM_ROUTER_PROFILE=driving
OSM_ROUTER_TIMEOUT_SECONDS=12

# OSM is the primary place source. Known categories use a bounded Overpass
# query near the selected place before Nominatim and SerpApi fallback.
# SerpApi is used only when both OSM stages have no usable result.
OSM_PLACE_SEARCH_RADIUS_METERS=5000
SERP_API_KEY=

# Disabled by default. Serp directions are external, temporary display data and
# are never saved with OSM-derived routes or OSM review records.
ENABLE_SERP_DIRECTIONS_FALLBACK=0

# Optional OpenBuildingMap local mirror. It becomes the primary source for
# building footprints; OpenStreetMap and Overture remain fallbacks.
OPENBUILDINGMAP_API_URL=
OPENBUILDINGMAP_TILE_TTL_DAYS=7

# Leave OVERTURE_BUILDINGS_PATH empty for the bounded remote fallback.
OVERTURE_BUILDINGS_PATH=
OVERTURE_RELEASE=2026-06-17.0
DISABLE_OVERTURE=0

# These defaults retain the source project's local data locations.
DATABASE_PATH=./backend/data/monument.db
DUCKDB_PATH=./__duckdb/duckdb.exe
