PORT=8787
APP_USER_AGENT=MonoCityExplorer/1.0 (replace-with-your-email@example.com)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
OVERPASS_BACKOFF_SECONDS=120

# Fallback only: local routing searches a bounded OSM road graph with Dijkstra.
# Use a managed or self-hosted endpoint for production fallback traffic.
OSM_ROUTER_BASE_URL=https://router.project-osrm.org
OSM_ROUTER_PROFILE=driving
OSM_ROUTER_TIMEOUT_SECONDS=12

# Used only after OSM/Nominatim has no usable place result.
SERP_API_KEY=
ENABLE_SERP_DIRECTIONS_FALLBACK=0

# Optional OpenBuildingMap local mirror, for example http://127.0.0.1:8000.
OPENBUILDINGMAP_API_URL=https://openbuildingmap.services.brahmai.in
OPENBUILDINGMAP_TILE_TTL_DAYS=7

# Prefer a local regional Overture GeoParquet file or glob. Leave empty to use
# the bounded remote fallback, or set DISABLE_OVERTURE=1 to skip it.
OVERTURE_BUILDINGS_PATH=
OVERTURE_RELEASE=2026-06-17.0
DISABLE_OVERTURE=0
