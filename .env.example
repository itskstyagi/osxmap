PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mono_city_explorer
APP_USER_AGENT=MonoCityExplorer/1.0 (replace-with-your-email@example.com)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Optional OpenBuildingMap local mirror, for example http://127.0.0.1:8000.
OPENBUILDINGMAP_API_URL=https://openbuildingmap.services.brahmai.in
OPENBUILDINGMAP_TILE_TTL_DAYS=7

# Prefer a local regional Overture GeoParquet file or glob. Leave empty to use
# the bounded remote fallback, or set DISABLE_OVERTURE=1 to skip it.
OVERTURE_BUILDINGS_PATH=
OVERTURE_RELEASE=2026-06-17.0
DISABLE_OVERTURE=0
